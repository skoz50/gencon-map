node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Build output
dist/
build/

# Test harness — run artifacts (see test/README.md)
test/.tmp/
test/screenshots/

# Source exhibit-map PDFs — large, not meant to ship; extraction scripts
# read them locally to regenerate the committed vendors.json/vendor-favorites.json
data/2019-prototype/source/
data/2019-prototype/__pycache__/
data/2026/source/
data/2026/__pycache__/

# Ingest scratch — photos of physical tokens and other local research inputs
# that feed data/2026/td-tokens.json but are not themselves shipped.
_scratch/

# tokendb.com scrape artifacts — local research inputs, not shipped.
# We ship only our own 142-token subset (data/2026/td-tokens.json) and its
# images; the full 3,807-token catalog and the raw HTML cache stay local.
# Regenerate with: node td/_scrape_tokendb.mjs
td/_tokendb_cache/
td/tokendb-catalog.json
